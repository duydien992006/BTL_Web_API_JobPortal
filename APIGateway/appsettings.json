// ============ APIGateway/appsettings.json ============
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "nguoidung-xacthuc-route": {
        "ClusterId": "nguoidung-cluster",
        "Match": { "Path": "/api/xacthuc/{**catch-all}" }
      },
      "nguoidung-kynang-route": {
        "ClusterId": "nguoidung-cluster",
        "Match": { "Path": "/api/kynang/{**catch-all}" }
      },
      "nguoidung-thongbao-route": {
        "ClusterId": "nguoidung-cluster",
        "Match": { "Path": "/api/thongbao/{**catch-all}" }
      },

      "hoso-route": {
        "ClusterId": "ungvien-cluster",
        "Match": { "Path": "/api/hoso/{**catch-all}" }
      },
      "donungtuyen-nopdon-route": {
        "ClusterId": "ungvien-cluster",
        "Match": { "Path": "/api/donungtuyen/nop-don" }
      },
      "donungtuyen-cuatoi-route": {
        "ClusterId": "ungvien-cluster",
        "Match": { "Path": "/api/donungtuyen/cua-toi" }
      },
      "denghi-phanhoi-route": {
        "ClusterId": "ungvien-cluster",
        "Match": { "Path": "/api/denghituyendung/{id}/phan-hoi" }
      },
      "denghi-theodon-route-ungvien": {
        "ClusterId": "ungvien-cluster",
        "Match": { "Path": "/api/denghituyendung/theo-don/{**catch-all}" }
      },

      "congty-route": {
        "ClusterId": "nhatuyendung-cluster",
        "Match": { "Path": "/api/congty/{**catch-all}" }
      },
      "tintuyendung-route": {
        "ClusterId": "nhatuyendung-cluster",
        "Match": { "Path": "/api/tintuyendung/{**catch-all}" }
      },
      "donungtuyen-doitrangthai-route": {
        "ClusterId": "nhatuyendung-cluster",
        "Match": { "Path": "/api/donungtuyen/doi-trang-thai" }
      },
      "donungtuyen-theotin-route": {
        "ClusterId": "nhatuyendung-cluster",
        "Match": { "Path": "/api/donungtuyen/theo-tin/{**catch-all}" }
      },
      "lichphongvan-route": {
        "ClusterId": "nhatuyendung-cluster",
        "Match": { "Path": "/api/lichphongvan/{**catch-all}" }
      },
      "denghi-gui-route": {
        "ClusterId": "nhatuyendung-cluster",
        "Match": { "Path": "/api/denghituyendung/gui" }
      },

      "baocao-route": {
        "ClusterId": "quantrivien-cluster",
        "Match": { "Path": "/api/baocao/{**catch-all}" }
      }
    },
    "Clusters": {
      "nguoidung-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:7001/" } } },
      "ungvien-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:7002/" } } },
      "nhatuyendung-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:7003/" } } },
      "quantrivien-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:7004/" } } }
    }
  }
}